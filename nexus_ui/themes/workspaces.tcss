Screen {
    background: #0b141e;
    color: #d9e7ef;
}

Header {
    background: #162735;
    color: #59dfc4;
    text-style: bold;
}

Footer {
    background: #111e29;
    color: #819eaf;
}

FooterKey {
    background: #111e29;
    color: #b8cedb;
}

Button {
    background: #1b303e;
    color: #c6dbe6;
    border: none;
    text-style: none;
    min-width: 8;
}

Button:hover {
    background: #25424b;
    color: #59dfc4;
}

Button:focus {
    background: #20443f;
    color: #59dfc4;
    text-style: bold;
}

Button.-success {
    background: #20443f;
    color: #59dfc4;
}

Button.-warning {
    background: #493c25;
    color: #e4bb78;
}

Button.-error {
    background: #492a32;
    color: #ff9292;
}

Button:disabled {
    background: #14212b;
    color: #526b7b;
}

Input {
    background: #101e29;
    color: #d9e7ef;
    border: tall #304856;
}

Input:focus {
    border: tall #59dfc4;
    background: #142633;
}

Input > .input--placeholder {
    color: #718c9c;
}

RichLog {
    background: #101e29;
    color: #d9e7ef;
    scrollbar-color: #385665;
    scrollbar-background: #101e29;
}

DataTable {
    background: #101e29;
    color: #d9e7ef;
    scrollbar-color: #385665;
    scrollbar-background: #101e29;
}

DataTable > .datatable--header {
    background: #1b303e;
    color: #59dfc4;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: #20443f;
    color: #e4edf3;
}

DataTable > .datatable--odd-row {
    background: #12222e;
}

DataTable > .datatable--even-row {
    background: #101e29;
}

ListView {
    background: #101e29;
    color: #b8cedb;
}

ListItem {
    background: #101e29;
    color: #b8cedb;
}

ListItem.-highlight {
    background: #20443f;
    color: #59dfc4;
}

VerticalScroll {
    scrollbar-size-vertical: 1;
    scrollbar-color: #385665;
    scrollbar-background: #101e29;
}

HorizontalScroll {
    scrollbar-color: #385665;
    scrollbar-background: #101e29;
}

ModalScreen {
    background: #071018 70%;
}

LoadingIndicator {
    background: #101e29;
    color: #59dfc4;
}

#navigation Button {
    min-width: 0;
    height: 1;
    margin: 0;
    padding: 0 1;
    background: #111e29;
    color: #b8cedb;
    content-align: left middle;
    text-align: left;
}

#navigation Button:hover {
    background: #25424b;
    color: #59dfc4;
}

#navigation Button.selected {
    background: #20443f;
    color: #59dfc4;
    text-style: bold;
}
